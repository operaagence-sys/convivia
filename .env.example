# Convivia - variables d'environnement (docs/06-trd.md section 15).
# Ce fichier ne contient AUCUNE valeur. Copie-le en .env.local (jamais versionne) en local;
# en preview et en production, les valeurs sont saisies dans Vercel et Supabase.
# Regle: aucune variable secrete ne commence par NEXT_PUBLIC_ (elle serait envoyee au navigateur).
# Le build refuse tout NEXT_PUBLIC_* absent de ce fichier (liste blanche PUBLIC_ENV_ALLOWLIST dans
# src/lib/env/guards.ts) et toute valeur publique qui ressemble a un secret (cle service_role,
# sb_secret_, cle FedaPay). Ajouter une variable publique = la declarer ici ET dans la liste.
# Exception: le prefixe NEXT_PUBLIC_VERCEL_ (variables systeme injectees par Vercel au build,
# non secretes) est accepte sans declaration; le controle des valeurs s'y applique aussi.
#
# VERCEL_ENV est fournie par Vercel (development, preview, production): ne la definis pas a la
# main. Absente (poste local, CI), elle vaut "pas la production": WhatsApp live et FedaPay live
# sont alors refuses par le code (src/lib/env/guards.ts).
#
# Valeurs par environnement
#   Local      : WHATSAPP_MODE=simulate, FEDAPAY_ENV=sandbox, PostHog et Sentry vides.
#   Preview    : WHATSAPP_MODE=test + WHATSAPP_TEST_ALLOWLIST, FEDAPAY_ENV=sandbox.
#   Production : WHATSAPP_MODE=live, FEDAPAY_ENV=live (seulement la).
# En production (VERCEL_ENV=production), build et demarrage echouent si FedaPay est en sandbox
# (env ou cle) ou si une variable de PRODUCTION_REQUIRED_ENV (src/lib/env/guards.ts) manque.
# Cette liste ne contient que les variables des fonctions deja livrees; les autres sont dans
# PRODUCTION_ENV_PLANNED (FedaPay: tranche 6; QR et scan: tranche 7; WhatsApp et opt-out:
# tranche 11) et deviennent obligatoires quand leur tranche arrive.

# --- Site ---
# URL de base du site (liens absolus, Open Graph). Public.
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
# Cle anonyme: publique par conception (protegee par la RLS). La cle service_role est
# serveur uniquement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cle secrete Supabase (`sb_secret_...`), serveur uniquement, jamais NEXT_PUBLIC_. Sert uniquement
# au client "auth seulement" qui transmet l'IP du visiteur (en-tete sb-forwarded-for) a Supabase Auth.
SUPABASE_SECRET_KEY=

# --- FedaPay (sandbox / live) ---
FEDAPAY_ENV=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# --- WhatsApp, API Cloud de Meta (simulate / test / live) ---
WHATSAPP_MODE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Numeros E.164 separes par des virgules, 5 au plus (mode test uniquement).
WHATSAPP_TEST_ALLOWLIST=

# --- Signatures, empreintes, chiffrement ---
QR_SIGNING_SECRET=
SCAN_SESSION_SECRET=
OPTOUT_HASH_SECRET=
SCAN_CODE_ENCRYPTION_KEY=
# HMAC-SHA256 de l'e-mail du code de connexion pour login_attempts (tranche 2, TRD 7.1, D24, D52):
# serveur uniquement, 32 octets aleatoires (ex. `openssl rand -base64 32`), un secret par environnement.
# 32 caracteres au moins.
LOGIN_ATTEMPTS_HASH_SECRET=
# HMAC-SHA256 de l'IP du visiteur (limite par IP, table login_ip_attempts): 32 caracteres au moins,
# secret distinct de celui ci-dessus, un par environnement.
LOGIN_IP_HASH_SECRET=
# Poivre du code de connexion (HMAC du code stocke dans login_attempts, colonne code_hmac): serveur
# uniquement, Sensitive, 32 caracteres au moins, un secret DIFFERENT par environnement.
# Les trois secrets de connexion (LOGIN_ATTEMPTS_HASH_SECRET, LOGIN_IP_HASH_SECRET, LOGIN_CODE_PEPPER)
# doivent avoir trois valeurs differentes: des valeurs identiques sont refusees au build/demarrage.
LOGIN_CODE_PEPPER=

# --- E-mail (Resend, appele depuis Node par src/lib/email; Supabase n'envoie plus aucun e-mail) ---
# Cle Resend (droit "Sending access"), serveur uniquement, une cle par environnement.
RESEND_API_KEY=
# Expediteur (defaut Convivia <noreply@convivia.app>). En production il doit etre sur convivia.app,
# sinon le demarrage est refuse.
EMAIL_FROM=
# Adresse de reponse (defaut support@convivia.app; variable definie mais vide = aucun en-tete).
EMAIL_REPLY_TO=
# Adresses separees par des virgules. Hors production, seules ces adresses recoivent un e-mail
# (les autres: rien n'est envoye, sans erreur). Ignoree en production.
EMAIL_TEST_ALLOWLIST=

# --- Analyse (PostHog UE; vitrine et espace organisateur seulement, jamais /i/*) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Sentry (vide = inactif) ---
# DSN serveur (non publie). Sentry n'est charge que cote serveur; aucun SDK navigateur.
SENTRY_DSN=
# DSN navigateur: reserve a un futur SDK navigateur hors /i/*. Le DSN est public par nature.
NEXT_PUBLIC_SENTRY_DSN=
# Televersement des source maps au build (secret, CI/Vercel seulement) et projet cible.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
