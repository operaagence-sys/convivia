# Convivia - variables d'environnement (docs/06-trd.md section 15).
# Ce fichier ne contient AUCUNE valeur. Copie-le en .env.local (jamais versionne) en local;
# en preview et en production, les valeurs sont saisies dans Vercel et Supabase.
# Regle: aucune variable secrete ne commence par NEXT_PUBLIC_ (elle serait envoyee au navigateur).
# Le build refuse tout NEXT_PUBLIC_* absent de ce fichier (liste blanche PUBLIC_ENV_ALLOWLIST dans
# src/lib/env/guards.ts) et toute valeur publique qui ressemble a un secret (cle service_role,
# sb_secret_, cle FedaPay). Ajouter une variable publique = la declarer ici ET dans la liste.
#
# VERCEL_ENV est fournie par Vercel (development, preview, production): ne la definis pas a la
# main. Absente (poste local, CI), elle vaut "pas la production": WhatsApp live et FedaPay live
# sont alors refuses par le code (src/lib/env/guards.ts).
#
# Valeurs par environnement
#   Local      : WHATSAPP_MODE=simulate, FEDAPAY_ENV=sandbox, PostHog et Sentry vides.
#   Preview    : WHATSAPP_MODE=test + WHATSAPP_TEST_ALLOWLIST, FEDAPAY_ENV=sandbox.
#   Production : WHATSAPP_MODE=live, FEDAPAY_ENV=live (seulement la).
# En production (VERCEL_ENV=production), build et demarrage echouent si FedaPay est en sandbox
# (env ou cle) ou si une variable de PRODUCTION_REQUIRED_ENV (src/lib/env/guards.ts) manque.
# Cette liste ne contient que les variables des fonctions deja livrees; les autres sont dans
# PRODUCTION_ENV_PLANNED (FedaPay: tranche 6; QR et scan: tranche 7; WhatsApp et opt-out:
# tranche 11) et deviennent obligatoires quand leur tranche arrive.

# --- Site ---
# URL de base du site (liens absolus, Open Graph). Public.
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
# Cle anonyme: publique par conception (protegee par la RLS). La cle service_role est
# serveur uniquement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- FedaPay (sandbox / live) ---
FEDAPAY_ENV=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# --- WhatsApp, API Cloud de Meta (simulate / test / live) ---
WHATSAPP_MODE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Numeros E.164 separes par des virgules, 5 au plus (mode test uniquement).
WHATSAPP_TEST_ALLOWLIST=

# --- Signatures, empreintes, chiffrement ---
QR_SIGNING_SECRET=
SCAN_SESSION_SECRET=
OPTOUT_HASH_SECRET=
SCAN_CODE_ENCRYPTION_KEY=

# --- E-mail (Resend, aussi configure comme SMTP de Supabase Auth) ---
RESEND_API_KEY=

# --- Analyse (PostHog UE; vitrine et espace organisateur seulement, jamais /i/*) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Sentry (vide = inactif) ---
# DSN serveur (non publie). Sentry n'est charge que cote serveur; aucun SDK navigateur.
SENTRY_DSN=
# DSN navigateur: reserve a un futur SDK navigateur hors /i/*. Le DSN est public par nature.
NEXT_PUBLIC_SENTRY_DSN=
# Televersement des source maps au build (secret, CI/Vercel seulement) et projet cible.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
